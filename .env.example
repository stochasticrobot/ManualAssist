# Create your private .env from this example. Never commit real credentials.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2

# Your AWS account must have access to the selected models in this region.
TEXT_PROVIDER=bedrock
VISION_PROVIDER=bedrock
BEDROCK_TEXT_MODEL_ID=deepseek.v3.2
BEDROCK_VISION_MODEL_ID=us.amazon.nova-2-lite-v1:0
